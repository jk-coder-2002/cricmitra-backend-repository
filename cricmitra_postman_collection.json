						"body": {
							"mode": "raw",
							"raw": "{\n    \"inningsId\": \"innings_id\",\n    \"overNumber\": 1,\n    \"ballNumber\": 1,\n    \"bowlerId\": \"bowler_id\",\n    \"batsmanId\": \"batsman_id\",\n    \"nonStrikerId\": \"non_striker_id\",\n    \"runsBat\": 4,\n    \"extras\": {\n        \"type\": \"none\",\n        \"runs\": 0\n    },\n    \"isWicket\": false\n}"
